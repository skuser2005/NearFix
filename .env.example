# NearFix local configuration
PORT=5050
JWT_SECRET=change-this-in-production

# Optional AI provider (OpenAI-compatible endpoint). Local smart assistant works without these.
AI_API_KEY=
AI_API_URL=
AI_MODEL=gpt-4o-mini

# Optional Razorpay TEST gateway. Manual UPI QR + Cash verification work without keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# No Google Maps API key is required.
# Maps: OpenStreetMap + Leaflet | Routing: OSRM | GPS: browser Geolocation API

# Optional real SMS delivery for the ARRIVAL OTP only.
# Without these values, demo mode shows the generated arrival OTP in the customer verification dialog.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
